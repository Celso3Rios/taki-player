<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/contentRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="horizontal"
    android:background="@color/bg">

    <!-- Biblioteca compacta, fixa a esquerda. -->
    <LinearLayout
        android:id="@+id/sidebarPanel"
        android:layout_width="0dp"
        android:layout_weight="3.4"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingTop="6dp"
        android:paddingBottom="4dp"
        android:background="@color/surface">

        <LinearLayout
            android:id="@+id/topPanel"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="7dp"
            android:paddingEnd="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="▶ TAKI PLAYER"
                android:textColor="@color/primary"
                android:textSize="17sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black" />
            <Button
                android:id="@+id/btnImport"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_primary"
                android:text="IMPORTAR"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:paddingStart="9dp"
                android:paddingEnd="9dp" />
        </LinearLayout>
        <TextView
            android:id="@+id/txtSummary"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:paddingStart="9dp"
            android:paddingEnd="8dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Importe sua lista M3U"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <HorizontalScrollView
            android:id="@+id/tabsScroll"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:fillViewport="false"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/tabsContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="5dp"
                android:paddingEnd="5dp" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/filterPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <EditText
                    android:id="@+id/editSearch"
                    android:layout_width="0dp"
                    android:layout_height="39dp"
                    android:layout_weight="1"
                    android:hint="Buscar canais e vídeos"
                    android:background="@drawable/bg_input"
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:singleLine="true"
                    android:paddingStart="10dp"
                    android:paddingEnd="6dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/muted"
                    android:textSize="12sp" />
                <Button
                    android:id="@+id/btnFavorites"
                    android:layout_width="41dp"
                    android:layout_height="39dp"
                    android:layout_marginStart="4dp"
                    android:text="☆"
                    android:contentDescription="Mostrar favoritos"
                    android:textColor="@color/warning"
                    android:textSize="21sp"
                    android:background="@drawable/bg_input" />
            </LinearLayout>
            <Spinner
                android:id="@+id/spinnerCategory"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input" />
            <TextView
                android:id="@+id/txtListStatus"
                android:layout_width="match_parent"
                android:layout_height="21dp"
                android:gravity="center_vertical"
                android:text="Importe sua lista para começar"
                android:textColor="@color/muted"
                android:textSize="10sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerItems"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            android:clipToPadding="false"
            android:scrollbars="vertical" />
        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:visibility="gone"
            android:indeterminate="true"
            android:progressTint="@color/primary" />
    </LinearLayout>

    <!-- Video ocupa todo o lado direito. -->
    <LinearLayout
        android:id="@+id/rightPanel"
        android:layout_width="0dp"
        android:layout_weight="6.6"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/bg">
        <FrameLayout
            android:id="@+id/videoFrame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="6dp"
            android:background="#000000">
            <androidx.media3.ui.PlayerView
                android:id="@+id/playerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000"
                app:use_controller="true"
                app:show_buffering="when_playing"
                app:resize_mode="fit" />
            <TextView
                android:id="@+id/txtPlayerOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="18dp"
                android:text="▶

Escolha um canal, filme ou episódio"
                android:textColor="@color/muted"
                android:textAlignment="center"
                android:textSize="15sp"
                android:background="#DF081727" />
        </FrameLayout>
        <LinearLayout
            android:id="@+id/playerBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingEnd="5dp">
                <TextView
                    android:id="@+id/txtNowPlaying"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Nenhum vídeo selecionado"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/txtPlayerState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Pronto"
                    android:textColor="@color/muted"
                    android:textSize="10sp" />
            </LinearLayout>
            <Button
                android:id="@+id/btnExternal"
                android:layout_width="46dp"
                android:layout_height="37dp"
                android:layout_marginEnd="3dp"
                android:text="VLC"
                android:textAllCaps="false"
                android:textSize="11sp"
                android:textColor="@color/primary"
                android:background="@drawable/bg_input" />
            <Button
                android:id="@+id/btnRetry"
                android:layout_width="42dp"
                android:layout_height="37dp"
                android:layout_marginEnd="3dp"
                android:text="↻"
                android:contentDescription="Tentar reproduzir novamente"
                android:textSize="23sp"
                android:textColor="@color/white"
                android:background="@drawable/bg_input" />
            <Button
                android:id="@+id/btnCompatibility"
                android:layout_width="53dp"
                android:layout_height="37dp"
                android:layout_marginEnd="3dp"
                android:text="Rede"
                android:textAllCaps="false"
                android:contentDescription="Configurar compatibilidade de rede"
                android:textSize="11sp"
                android:textColor="@color/white"
                android:background="@drawable/bg_input" />
            <Button
                android:id="@+id/btnDiagnostics"
                android:layout_width="49dp"
                android:layout_height="37dp"
                android:layout_marginEnd="3dp"
                android:text="Erro"
                android:textAllCaps="false"
                android:contentDescription="Exibir diagnóstico de reprodução"
                android:textSize="11sp"
                android:textColor="@color/white"
                android:background="@drawable/bg_input" />
            <Button
                android:id="@+id/btnFullscreen"
                android:layout_width="42dp"
                android:layout_height="37dp"
                android:text="⛶"
                android:contentDescription="Alternar tela cheia"
                android:textSize="20sp"
                android:textColor="@color/white"
                android:background="@drawable/bg_input" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
